@FeignClient(name = "movie-service")
public interface MovieServiceClient {
    @GetMapping("/api/showtimes/{id}")
    ShowtimeInfoDto getShowtime(@PathVariable("id") Long id);

    @GetMapping("/api/showtimes/{id}/seats")
