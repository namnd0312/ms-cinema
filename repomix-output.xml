```typescript
// showtime-form-dialog.component.ts
@Component({
  selector: 'app-showtime-form-dialog',
  standalone: true,
  imports: [
    ReactiveFormsModule, MatDialogModule, MatFormFieldModule,
    MatInputModule, MatButtonModule, MatSelectModule
  ],
