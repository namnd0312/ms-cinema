 * Usage: node init-playwright.js [--ct] [--dir <path>]
 *
 * Options:
 *   --ct       Include component testing setup
 *   --dir      Target directory (default: current directory)
 */

const fs = require('fs');
const path = require('path');

// Parse arguments
const args = process.argv.slice(2);
