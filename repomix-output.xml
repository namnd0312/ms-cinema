/* Back button (link styled as icon-btn) */
a.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  padding: 0.5rem;
  border-radius: 6px;
  transition: background 0.2s, color 0.2s;
}

a.icon-btn.back-btn {
