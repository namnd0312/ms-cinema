  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.plan-icon {
  font-size: 1rem;
}

.phase-list {
  list-style: none;
}

.phase-item {
  margin-bottom: 0.25rem;
}

/* Inline section items (anchors within same doc) - indented with visual distinction */
.phase-item.inline-section {
  margin-left: 0.75rem;
  position: relative;
}

.phase-item.inline-section::before {
  content: '';
  position: absolute;
  left: -0.5rem;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border);
  border-radius: 1px;
}

.phase-item a {
