.unavailable-badge,
.nav-badge {
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  background: var(--text-muted);
  color: var(--bg-primary);
  margin-left: auto;
}

