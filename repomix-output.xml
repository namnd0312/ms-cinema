        assert.ok(values.includes('.env'));
      });
    });

    it('handles null/undefined input', () => {
      assert.deepStrictEqual(extractPaths(null), []);
      assert.deepStrictEqual(extractPaths(undefined), []);
      assert.deepStrictEqual(extractPaths({}), []);
    });
  });
});

